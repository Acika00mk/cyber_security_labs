# Copy this file to .env (in the shoplab/ folder) to change the defaults.

# Port of the API server (and of the built shop when using `npm start`). Do not use 8080.
PORT=3000

# Secret used to sign the session cookie. A fixed value is fine for this lab.
SESSION_SECRET=change-me-in-lab

# off (default) or reflect. Only change this when the lecturer asks you to.
CORS_MODE=off
