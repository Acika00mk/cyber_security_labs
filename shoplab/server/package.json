{
  "name": "shoplab-server",
  "version": "1.0.0",
  "private": true,
  "description": "ShopLab API server",
  "main": "src/index.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning --env-file-if-exists=../.env src/index.js",
    "dev": "node --disable-warning=ExperimentalWarning --env-file-if-exists=../.env --watch src/index.js",
    "reset-db": "node -e \"require('fs').rmSync('data', { recursive: true, force: true }); console.log('Database removed. It will be recreated on the next start.')\"",
    "test": "node --disable-warning=ExperimentalWarning --test"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "shoplab": "file:..",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "supertest": "^7.0.0"
  }
}
